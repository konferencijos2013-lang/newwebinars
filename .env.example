# Frontend (public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase CLI / Edge Functions (secret - never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Sentry, analytics, etc.
# VITE_SENTRY_DSN=

# Payments (Edge Function secrets)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AI (Edge Function secrets)
OPENAI_API_KEY=sk-...

# Scheduled reminder worker (use a long, random value; never expose it to the frontend)
DELIVERY_WORKER_SECRET=replace-with-a-long-random-secret

# Optional: Send email notifications through Supabase Auth SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
