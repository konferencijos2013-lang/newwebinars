# Frontend (public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Edge Functions (server-only; never expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical frontend origin used for Stripe redirects
APP_URL=https://app.example.com
# Optional comma-separated additional exact origins for local development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Sentry, analytics, etc.
# VITE_SENTRY_DSN=

# Payments (Edge Function secrets)
STRIPE_SECRET_KEY=sk_test_or_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe price IDs are intentionally not stored here or committed. Bind each real recurring
# price to credit_plans.code using reviewed admin SQL, then enable that plan.

# AI (Edge Function secrets)
OPENAI_API_KEY=sk-...

# Scheduled reminder worker (use a long, random value; never expose it to the frontend)
DELIVERY_WORKER_SECRET=replace-with-a-long-random-secret

# Optional: Send email notifications through Supabase Auth SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
